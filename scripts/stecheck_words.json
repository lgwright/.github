{
  "_about": "Word lists for stecheck.py. jargon: a word with no single meaning in Simplified Technical English (STE), with the word to use and the other forms that also match. A lowercase-only entry has case_sensitive true, so the capital abbreviation (LO, PSD) goes to the abbreviation check. abbreviations: capital tokens that need no definition (units, standard computing terms, emphasis words). stative: past participles that describe a device state after is or are, so the passive check accepts them.",
  "jargon": {
    "ack": {"use": "acknowledge, or confirm", "forms": ["acks", "acked", "acking"]},
    "pin": {"use": "hold at a value, or fix", "forms": ["pins", "pinned", "pinning"]},
    "park": {"use": "stop and hold, or pause", "forms": ["parks", "parked", "parking"]},
    "ref": {"use": "reference", "forms": ["refs"]},
    "lo": {"use": "local oscillator (LO)", "case_sensitive": true},
    "dz": {"use": "dead zone", "case_sensitive": true},
    "psd": {"use": "power spectral density (PSD)", "case_sensitive": true},
    "cal": {"use": "calibration, or calibrate", "case_sensitive": true, "forms": ["cals"]},
    "polcal": {"use": "polarization calibration", "forms": ["polcals"]},
    "recal": {"use": "calibrate again", "forms": ["recals"]},
    "tbd": {"use": "not known yet (say who decides and when)"},
    "etc.": {"use": "list all the items"},
    "ok": {"use": "correct, or satisfactory", "forms": ["okay", "ok?"]},
    "gonna": {"use": "will"},
    "wanna": {"use": "want to"},
    "utilize": {"use": "use", "forms": ["utilizes", "utilized", "utilizing", "utilise", "utilises", "utilised", "utilising"]},
    "leverage": {"use": "use", "forms": ["leverages", "leveraged", "leveraging"]},
    "via": {"use": "through, or with"},
    "aforementioned": {"use": "this, or that"},
    "e.g.": {"use": "for example"},
    "i.e.": {"use": "that is"},
    "w/": {"use": "with"},
    "w/o": {"use": "without"},
    "aka": {"use": "also called"},
    "wrt": {"use": "relative to"},
    "in order to": {"use": "to"}
  },
  "abbreviations": [
